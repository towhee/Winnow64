         <string>Toggles</string>
        </property>
       </item>
      </item>
      <item>
       <property name="text">
        <string>Windows</string>
       </property>
       <property name="font">
        <font>
         <bold>true</bold>
        </font>
       </property>
       <property name="text">
        <string/>
       </property>
       <property name="text">
        <string/>
       </property>
       <item>
        <property name="text">
         <string>Files Panel</string>
        </property>
        <property name="text">
         <string>F3</string>
        </property>
        <property name="text">
         <string>Toggles visibility</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Favourites Panel</string>
        </property>
        <property name="text">
         <string>F4</string>
        </property>
        <property name="text">
         <string>Toggles visibility</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Filters Panel</string>
        </property>
        <property name="text">
         <string>F5</string>
        </property>
        <property name="text">
         <string>Toggles visibility</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Catalog Panel</string>
        </property>
        <property name="text">
         <string>Shift + F2</string>
        </property>
        <property name="text">
         <string>Search all catalogued images</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Metadata Panel</string>
        </property>
        <property name="text">
         <string>F6</string>
        </property>
        <property name="text">
         <string>Toggles visibility</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Thumbnails Panel</string>
        </property>
        <property name="text">
         <string>F7</string>
        </property>
        <property name="text">
         <string>Toggles visibility</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Embellish Panel</string>
        </property>
        <property name="text">
         <string>F8</string>
        </property>
        <property name="text">
         <string>Toggles visibility</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Develop Panel</string>
        </property>
        <property name="text">
         <string>F9</string>
        </property>
        <property name="text">
         <string>Toggles visibility</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Develop History Panel</string>
        </property>
        <property name="text">
         <string>H</string>
        </property>
        <property name="text">
         <string>Shows / raises the develop history panel; in Develop mode</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Develop Presets Panel</string>
        </property>
        <property name="text">
         <string>P</string>
        </property>
        <property name="text">
         <string>Shows / raises the develop presets panel; in Develop mode</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Application Statusbar</string>
        </property>
        <property name="text">
         <string>F10</string>
        </property>
        <property name="text">
         <string>Toggles visibility</string>
        </property>
       </item>
      </item>
      <item>
       <property name="text">
        <string>Develop</string>
       </property>
       <property name="font">
        <font>
         <bold>true</bold>
        </font>
       </property>
       <item>
        <property name="text">
         <string>Develop Mode</string>
        </property>
        <property name="text">
         <string>D</string>
        </property>
        <property name="text">
         <string>Enter Develop operation mode.  To go back to Preview mode press E (loupe), G (grid) or T (table).</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Original / Developed</string>
        </property>
        <property name="text">
         <string>Y</string>
        </property>
        <property name="text">
         <string>Switch the thumbnails and the loupe between the camera&apos;s picture (Original) and your develop edits (Developed).  Not available in Develop mode, which always shows the developed image.  Also on the status bar dropdown at the far left and in the View menu.</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Develop Mode keys</string>
        </property>
        <property name="text">
         <string>R  N  M  O  S  W  X  H  P</string>
        </property>
        <property name="text">
         <string>These nine keys mean something different in Develop mode than they do in Preview mode: in Preview, S is Slideshow, W is New Workspace, X is Reject, O is Open Folder, P is Pick, and R / N / M / H do nothing. Every other shortcut in this list behaves the same in both modes.</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Image selection</string>
        </property>
        <property name="text">
         <string>Arrows, PgUp / PgDn, Home / End</string>
        </property>
        <property name="text">
         <string>IGNORED in Develop mode unless the Thumbnails panel has the focus, so the keys cannot navigate off the image being developed. Click a thumbnail to give the panel focus. Alt + the same keys still scroll and pan the image.</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Nudge Slider</string>
        </property>
        <property name="text">
         <string>Left / Right (PageUp / PageDown = larger step)</string>
        </property>
        <property name="text">
         <string>Adjusts the focused slider; click or Tab to a slider to give it focus (it shows an accent bar)</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>New Mask</string>
        </property>
        <property name="text">
         <string>N</string>
        </property>
        <property name="text">
         <string>Adds a mask to this image (prompts for a name); in Develop mode</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Tweak Mask</string>
        </property>
        <property name="text">
         <string>M</string>
        </property>
        <property name="text">
         <string>Pops the submask type menu for the active mask, appending a submask; same as the [+] on the mask panel's Submasks list. In Develop mode. Global applies to the whole image and cannot be masked</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Mask Overlay</string>
        </property>
        <property name="text">
         <string>O</string>
        </property>
        <property name="text">
         <string>Hide / show the current mask overlay; while a submask is being defined</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Commit Mask (add submask)</string>
        </property>
        <property name="text">
         <string>Return</string>
        </property>
        <property name="text">
         <string>Folds the submask being defined into the mask; same as the panel's &quot;Add and Commit&quot; button. Esc discards it instead. On a submask re-opened from the Submasks list, Return / Esc simply close it (&quot;Done&quot;) - its edits are already part of the mask</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Subtract Submask</string>
        </property>
        <property name="text">
         <string>Opt/Alt (held)</string>
        </property>
        <property name="text">
         <string>The overlay previews the submask being REMOVED from the mask, and Update / Return commits it that way; while a submask is being defined. Held while painting a Brush or Object submask it keeps that meaning - the image shows the mask retreating as you paint</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Intersect Submask</string>
        </property>
        <property name="text">
         <string>Shift + Opt/Alt (held)</string>
        </property>
        <property name="text">
         <string>The overlay previews the mask reduced to where it OVERLAPS the submask, and Update / Return commits it that way; while a submask is being defined</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Show Sharpening Mask</string>
        </property>
        <property name="text">
         <string>Opt/Alt + drag Masking</string>
        </property>
        <property name="text">
         <string>Held while dragging the Detail panel's Masking slider, the photo is replaced by the sharpening mask in black and white - white is sharpened, black is protected - so the slider can be set by looking at the whole frame. Shown only for the duration of the drag</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Auto Mask (Brush)</string>
        </property>
        <property name="text">
         <string>A</string>
        </property>
        <property name="text">
         <string>Toggles; while a brush mask tool is active</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Resize Brush (Brush / Object mask / Spot)</string>
        </property>
        <property name="text">
         <string>[ / ]  (or two-finger drag)</string>
        </property>
        <property name="text">
         <string>Shrinks / grows the brush; while a Brush, Object mask or Spot tool is active. In the mask panel, while you are adding a stroke, hold Shift when changing an attribute to change only the LAST stroke painted - the panel header always states what the adjustment will apply to</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Feather (Gradient / Brush mask)</string>
        </property>
        <property name="text">
         <string>Shift + scroll (wheel or two-finger drag)</string>
        </property>
        <property name="text">
         <string>Softens / hardens the mask edge; while a Linear Gradient, Radial Gradient or Brush mask tool is active. Brush feather applies to the NEXT stroke while the submask is being built; on a submask re-opened from the Submasks list it re-feathers every stroke already painted</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Proportional Resize (Radial Gradient mask)</string>
        </property>
        <property name="text">
         <string>Shift + drag an axis handle</string>
        </property>
        <property name="text">
         <string>Scales both axes together so the ellipse keeps its proportions (a circle stays a circle); while a Radial Gradient mask tool is active</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Undo Stroke (Brush / Object mask)</string>
        </property>
        <property name="text">
         <string>Cmd/Ctrl + Z</string>
        </property>
        <property name="text">
         <string>Removes the last painted stroke; while a Brush or Object mask tool is active</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Crop / Transform Panel</string>
        </property>
        <property name="text">
         <string>R</string>
        </property>
        <property name="text">
         <string>Toggles the crop / perspective panel and its crop tool, applying changes on close (Esc cancels instead); in Develop mode</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Lock Aspect Ratio</string>
        </property>
        <property name="text">
         <string>A</string>
        </property>
        <property name="text">
         <string>Toggles; while Transform is active (panel or crop overlay)</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Flip Aspect Ratio</string>
        </property>
        <property name="text">
         <string>F</string>
        </property>
        <property name="text">
         <string>Swaps the crop between landscape and portrait; while Transform is active (panel or crop overlay)</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Transform Mode</string>
        </property>
        <property name="text">
         <string>C / L / W</string>
        </property>
        <property name="text">
         <string>Select Crop / Level / Warp; while Transform is active (panel or crop overlay)</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Commit Transform</string>
        </property>
        <property name="text">
         <string>Return / Enter</string>
        </property>
        <property name="text">
         <string>Applies this crop / level / warp and closes the panel, the same as pressing R again (while tracing a Warp quad, Enter commits the quad instead); in Develop mode</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Cancel Transform</string>
        </property>
        <property name="text">
         <string>Esc</string>
        </property>
        <property name="text">
         <string>Discards this crop / level / warp session and closes the panel (R closes but keeps the changes); in Develop mode</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>White Balance Sampler</string>
        </property>
        <property name="text">
         <string>W</string>
        </property>
        <property name="text">
         <string>Arms the Basic panel's white-balance dropper (click a neutral to balance from it); in Develop mode. While a Transform session is active W means Warp instead</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Cancel White Balance Dropper</string>
        </property>
        <property name="text">
         <string>Esc</string>
        </property>
        <property name="text">
         <string>Disarms the Basic panel's white-balance dropper without sampling; in Develop mode</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>White Balance from Skin</string>
        </property>
        <property name="text">
         <string>Opt/Alt + click</string>
        </property>
        <property name="text">
         <string>With the white-balance dropper armed, Opt/Alt-click a lit midtone area of skin to correct the skin colour instead of sampling a neutral; in Develop mode</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Spot Removal</string>
        </property>
        <property name="text">
         <string>S</string>
        </property>
        <property name="text">
         <string>Toggles the spot-removal tool (click a blemish to heal it); in Develop mode</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Zoom / Pan (hold)</string>
        </property>
        <property name="text">
         <string>Space</string>
        </property>
        <property name="text">
         <string>Hold Space to temporarily zoom/pan over any mask, spot or crop tool (click toggles zoom, drag pans); release resumes the tool. The mouse wheel / two-finger scroll zooms the image; while a Spot or Brush tool is armed the wheel resizes it, so hold Space to zoom with the wheel there. In Develop mode</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Export</string>
        </property>
        <property name="text">
         <string>X</string>
        </property>
        <property name="text">
         <string>Exports the selected images with their develop settings applied; in Develop mode</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Save Develop Preset</string>
        </property>
        <property name="text">
         <string>Cmd/Ctrl + Shift + N</string>
        </property>
        <property name="text">
         <string>Saves the current develop settings as a reusable preset; in Develop mode</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Copy Develop Settings</string>
        </property>
        <property name="text">
         <string>Cmd/Ctrl + Opt/Alt + C</string>
        </property>
        <property name="text">
         <string>Opens a checklist and copies the settings you tick to the develop clipboard; in Develop mode</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Paste Develop Settings</string>
        </property>
        <property name="text">
         <string>Cmd/Ctrl + Opt/Alt + V</string>
        </property>
        <property name="text">
         <string>Applies the copied settings to this image, on the selected scope, as one history step; in Develop mode</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Run Develop Preset</string>
        </property>
        <property name="text">
         <string>P</string>
        </property>
        <property name="text">
         <string>Applies a saved develop preset (NOT IMPLEMENTED YET); in Develop mode. In Preview, P is Pick</string>
        </property>
       </item>
      </item>
      <item>
       <property name="text">
        <string>Workspaces</string>
       </property>
       <property name="font">
        <font>
         <bold>true</bold>
        </font>
       </property>
       <item>
        <property name="text">
         <string>Select Workspace</string>
        </property>
        <property name="text">
         <string>Cmd/Ctrl + 0 to 9</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>New Workspace</string>
        </property>
        <property name="text">
         <string>W</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Manage Workspaces</string>
        </property>
        <property name="text">
         <string>Cmd/Ctrl + W</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Default Workspace</string>
        </property>
        <property name="text">
         <string>Cmd/Ctrl + Shift +W</string>
        </property>
       </item>
      </item>
      <item>
       <property name="text">
        <string>Video</string>
       </property>
       <item>
        <property name="text">
         <string>Play / Pause</string>
        </property>
        <property name="text">
         <string>Spacebar</string>
        </property>
        <property name="text">
         <string>Also mouse click on video</string>
        </property>
       </item>
      </item>
      <item>
       <property name="text">
        <string>Slideshow</string>
       </property>
       <property name="font">
        <font>
         <bold>true</bold>
        </font>
       </property>
       <item>
        <property name="text">
         <string>Start</string>
        </property>
        <property name="text">
         <string>S</string>
        </property>
        <property name="text">
         <string/>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Exit</string>
        </property>
        <property name="text">
         <string>Esc or S</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Change Delay Between Slides</string>
        </property>
        <property name="text">
         <string>1 - 9</string>
        </property>
        <property name="text">
         <string>Only while slideshow active</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Wrap at end of folder</string>
        </property>
        <property name="text">
         <string>W</string>
        </property>
        <property name="text">
         <string>Only while slideshow active (Toggles)</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Random / Sequential progress</string>
        </property>
        <property name="text">
         <string>R</string>
        </property>
        <property name="text">
         <string>Toggles</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Go back to previous random slide</string>
        </property>
        <property name="text">
         <string>Backspace</string>
        </property>
        <property name="text">
         <string/>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Pause / Continue</string>
        </property>
        <property name="text">
         <string>Spacebar</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Display shortcuts during slideshow</string>
        </property>
        <property name="text">
         <string>H</string>
        </property>
       </item>
      </item>
      <item>
       <property name="text">
        <string>Help</string>
       </property>
       <item>
        <property name="text">
         <string>Help document</string>
        </property>
        <property name="text">
         <string>?</string>
        </property>
       </item>
      </item>
      <item>
       <property name="text">
        <string>Preferences</string>
       </property>
       <property name="text">
        <string>Cmd/Ctrl + ,</string>
       </property>
       <property name="text">
        <string>, = comma</string>
       </property>
      </item>
     </widget>
    </item>
   </layout>
  </widget>
 </widget>
 <resources/>
 <connections/>
</ui>
