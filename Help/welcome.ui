         </item>
         <item>
          <widget class="QLabel" name="getStartedLabel">
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p align=&quot;center&quot;&gt;&lt;span style=&quot; font-size:13pt; color:#cccccc;&quot;&gt;Winnow is a photo asset manager / editor. It can access your photos via Folders or the Library (a database of your images). To get started, select Folders and pick a folder or from the menu: &lt;/span&gt;&lt;span style=&quot; font-size:13pt; font-style:italic; color:#cccccc;&quot;&gt;File &amp;gt; Open Folder&lt;/span&gt;&lt;span style=&quot; font-size:13pt; color:#cccccc;&quot;&gt;.&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
         </item>
        </layout>
       </widget>
