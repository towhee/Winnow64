        </property>
        <layout class="QHBoxLayout" name="horizontalLayout_2">
         <item>
          <widget class="QLabel" name="tipsLabel">
           <property name="minimumSize">
            <size>
             <width>500</width>
             <height>0</height>
            </size>
           </property>
           <property name="maximumSize">
            <size>
             <width>1000</width>
             <height>16777215</height>
            </size>
           </property>
           <property name="frameShape">
            <enum>QFrame::Shape::Box</enum>
           </property>
           <property name="lineWidth">
            <number>1</number>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600; color:#ffffff;&quot;&gt;Modes&lt;/span&gt;&lt;span style=&quot; color:#cccccc;&quot;&gt;: &lt;br/&gt;Browse, Develop, Keywords, Map, Embellish and Slideshow reconfigure the workspace to carry out these activities efficiently.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600; color:#ffffff;&quot;&gt;Help&lt;/span&gt;&lt;span style=&quot; color:#cccccc;&quot;&gt;: &lt;br/&gt;There are some help videos at &lt;/span&gt;&lt;a href=&quot;http://winnow.ca/&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#007af4;&quot;&gt;winnow.ca&lt;/span&gt;&lt;/a&gt;&lt;span style=&quot; color:#cccccc;&quot;&gt;. They can also be accessed via Help &amp;gt; About.  Help is available in Winnow via the shortcut '?' or the ? buttons sprinkled throughout Winnow.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600; color:#ffffff;&quot;&gt;Shortcuts&lt;/span&gt;&lt;span style=&quot; color:#cccccc;&quot;&gt;: &lt;br/&gt;Most of the shortcuts are shown in the menus. You can see a complete list via the menu: &lt;/span&gt;&lt;span style=&quot; font-style:italic; color:#cccccc;&quot;&gt;Help &amp;gt; Shortcuts&lt;/span&gt;&lt;span style=&quot; color:#cccccc;&quot;&gt;.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600; color:#ffffff;&quot;&gt;Workspaces&lt;/span&gt;&lt;span style=&quot; color:#cccccc;&quot;&gt;: &lt;br/&gt;Each mode has its own layout. Arrange the panels the way you like and use Window &amp;gt; Workspace &amp;gt; Save Layout to make it the layout for that mode. You can also save custom workspaces for a mode and switch to them instantly with Ctrl/Cmd 0-9.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600; color:#ffffff;&quot;&gt;Panels&lt;/span&gt;&lt;span style=&quot; color:#cccccc;&quot;&gt;: &lt;br/&gt;The panels will float or dock to the top, bottom, right or left sides of the main window.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600; color:#ffffff;&quot;&gt;Context Menus&lt;/span&gt;&lt;span style=&quot; color:#cccccc;&quot;&gt;: &lt;br/&gt;Right mouse click to see context menus. Right clicking in the image panel (the one where this text resides) will show the main menu. This is handy when the main menu is hidden in full screen mode.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600; color:#ffffff;&quot;&gt;Tool tips&lt;/span&gt;&lt;span style=&quot; color:#cccccc;&quot;&gt;: &lt;br/&gt;Hover over an item with the mouse to see a tool tip. Try this in the preferences dialog to see explanations for different settings.&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="textFormat">
            <enum>Qt::TextFormat::RichText</enum>
           </property>
