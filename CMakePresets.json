{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "_base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QT_DIR}",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0"
      }
    },

    {
      "name": "mac-debug",
      "displayName": "macOS Debug",
      "inherits": "_base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "HOMEBREW_PREFIX": "/opt/homebrew"
      }
    },
    {
      "name": "mac-release",
      "displayName": "macOS Release",
      "inherits": "_base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "description": "Apple Silicon release: STATIC OpenCV/libtiff/libjpeg-turbo/libjxl + Microsoft's arm64 ONNX Runtime 1.23.2, installed by packaging/macos/build_mac_deps.sh arm64. Homebrew is ignored: its bottles are built for the host macOS. macOS 13.4+ (ORT's floor).",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HOMEBREW_PREFIX": "/opt/homebrew",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.4",
        "WINNOW_MAC_DEPS_PREFIX": "$env{HOME}/Projects/winnow-deps/macos-arm64",
        "CMAKE_IGNORE_PREFIX_PATH": "/opt/homebrew;/usr/local",
        "WINNOW_ENABLE_ORT": "ON",
        "WINNOW_REQUIRE_ORT": "ON"
      }
    },
    {
      "name": "mac-release-x86_64",
      "displayName": "macOS Release (Intel x86_64)",
      "description": "Intel build, cross-compiled on Apple Silicon: the x86_64 slice of the universal official Qt + the same static deps for x86_64 (packaging/macos/build_mac_deps.sh x86_64). Inherits mac-release's macOS 13.4 floor, ORT and Homebrew exclusion.",
      "inherits": "mac-release",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "WINNOW_MAC_DEPS_PREFIX": "$env{HOME}/Projects/winnow-deps/macos-x86_64",
        "WINNOW_BUILD_TESTS": "OFF"
      }
    },

    {
      "name": "mac-tsan",
      "displayName": "macOS ThreadSanitizer",
      "inherits": "_base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "HOMEBREW_PREFIX": "/opt/homebrew",
        "WINNOW_SANITIZE_THREAD": "ON",
        "CMAKE_MAKE_PROGRAM": "/Users/roryhill/Qt/Tools/Ninja/ninja",
        "CMAKE_C_COMPILER": "/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/clang",
        "CMAKE_CXX_COMPILER": "/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/clang++",
        "CMAKE_OBJCXX_COMPILER": "/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/clang++"
      }
    },

    {
      "name": "mac-asan",
      "displayName": "macOS AddressSanitizer",
      "inherits": "_base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "HOMEBREW_PREFIX": "/opt/homebrew",
        "WINNOW_SANITIZE_ADDRESS": "ON",
        "CMAKE_MAKE_PROGRAM": "/Users/roryhill/Qt/Tools/Ninja/ninja",
        "CMAKE_C_COMPILER": "/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/clang",
        "CMAKE_CXX_COMPILER": "/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/clang++",
        "CMAKE_OBJCXX_COMPILER": "/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/clang++"
      }
    },

    {
      "name": "win-debug",
      "displayName": "Windows Debug (Ninja, x64)",
      "inherits": "_base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "WINNOW_ENABLE_ORT": "ON"
      }
    },
    {
      "name": "win-release",
      "displayName": "Windows Release (Ninja, x64)",
      "inherits": "_base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "WINNOW_ENABLE_ORT": "ON",
        "WINNOW_REQUIRE_ORT": "ON"
      }
    },

    {
      "name": "linux-debug",
      "displayName": "Linux Debug (Ninja, clang, system Qt)",
      "inherits": "_base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "WINNOW_ENABLE_ORT": "ON"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release (Ninja, clang, system Qt)",
      "inherits": "_base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "WINNOW_ENABLE_ORT": "ON",
        "WINNOW_REQUIRE_ORT": "ON"
      }
    }
  ],

  "buildPresets": [
    { "name": "mac-debug",   "configurePreset": "mac-debug"   },
    { "name": "mac-release", "configurePreset": "mac-release" },
    { "name": "mac-release-x86_64", "configurePreset": "mac-release-x86_64" },
    { "name": "mac-tsan",    "configurePreset": "mac-tsan"    },
    { "name": "mac-asan",    "configurePreset": "mac-asan"    },
    { "name": "win-debug",   "configurePreset": "win-debug"   },
    { "name": "win-release", "configurePreset": "win-release" },
    { "name": "linux-debug",   "configurePreset": "linux-debug"   },
    { "name": "linux-release", "configurePreset": "linux-release" }
  ]
}
